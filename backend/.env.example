# Smart Street Food Safety AI - Environment Configuration
#
# Copy to `.env` in this directory (backend/.env) and fill in real values.
# `.env` is gitignored -- never commit real credentials.
#
#   cp .env.example .env

PROJECT_NAME="Smart Street Food Safety AI"

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# JWT signing key. Generate one with:  openssl rand -hex 32
# Changing this invalidates every issued token (all users are signed out).
JWT_SECRET_KEY=""

# PostgreSQL connection.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/food_safety"

# Service-account JSON for Google Cloud. Powers label OCR (Cloud Vision) ONLY.
# Translation is local and needs no Google credential.
# Get it from: Google Cloud Console -> IAM & Admin -> Service Accounts ->
#   create a key (JSON) -> save outside the repo, e.g. C:/keys/gcp-sa.json
# Required APIs must be enabled on the project:
#   - Cloud Vision API
# (Cloud Translation API is NOT needed: translation runs locally.)
GOOGLE_APPLICATION_CREDENTIALS=""

# The Google Cloud project id that owns the service account above.
# No longer read by this codebase -- it existed for the Cloud Translate v3
# client, which has been removed. Kept because the project id is still
# meaningful operationally for Vision's billing and API enablement.
GOOGLE_CLOUD_PROJECT=""

# Unified Gemini API key for OCR, Translation, and Vision when provider is gemini.
# Get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=""
# Valid model names: gemini-2.0-flash (default, fast), gemini-1.5-flash, gemini-2.5-flash etc.
GEMINI_MODEL="gemini-2.0-flash"

# Google OAuth Client ID for verifying Google ID tokens
GOOGLE_CLIENT_ID=""

# DigiLocker OAuth credentials
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------
# Swap point for integrations/ocr_client.py.
#   "gemini" -- uses Gemini vision (default, needs GOOGLE_API_KEY)
#   "google_vision" -- uses Cloud Vision (needs GOOGLE_APPLICATION_CREDENTIALS)
# PaddleOCR is not an option: no cp314 wheel.
OCR_PROVIDER="gemini"
OCR_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Scan pipeline
# ---------------------------------------------------------------------------
# Where uploaded label photos are stored. Relative paths resolve against
# backend/. Served read-only at /uploads/scans.
SCAN_UPLOAD_DIR="var/uploads/scans"
SCAN_MAX_UPLOAD_MB=8
# Longest edge (px) an upload is downscaled to before OCR. Larger does not
# measurably improve label OCR accuracy but does cost latency and bandwidth.
SCAN_MAX_IMAGE_EDGE=1600

# --- Confidence thresholds ---
# Blended score below this -> "Needs review" (ask for a retake).
SCAN_REVIEW_THRESHOLD=0.45
# OCR confidence below this -> "Needs review" regardless of the blend. A
# clean-looking ingredient match against badly-read text is not evidence.
SCAN_MIN_USABLE_CONFIDENCE=0.25
# Similarity (%) required for a fuzzy ingredient match. Lower catches more
# OCR typos but risks false positives against real ingredients.
SCAN_FUZZY_MATCH_THRESHOLD=88

# --- Image-quality gate (runs before OCR, so it saves paid API calls) ---
# Laplacian variance; below this the photo is treated as blurry.
SCAN_MIN_BLUR_VARIANCE=60
# Acceptable mean brightness band (0-255).
SCAN_MIN_BRIGHTNESS=45
SCAN_MAX_BRIGHTNESS=225
# Max fraction of pixels allowed to be near-white (specular glare on the
# laminated packet). Above this, the vendor is asked to tilt the packet.
SCAN_MAX_GLARE_RATIO=0.12
# Minimum shorter-edge resolution (px).
SCAN_MIN_IMAGE_EDGE=480

# --- Translation ---
# Set false to skip translation entirely (fastest, English only).
SCAN_TRANSLATION_ENABLED=true

# Provider swap point for integrations/translate_client.py.
#   "indictrans2" -- local AI4Bharat model (default, offline, no API key)
#   "gemini" -- uses Gemini API (needs GOOGLE_API_KEY)
TRANSLATION_PROVIDER="indictrans2"

# Weights. TRANSLATION_MODEL_DIR is used when it exists, which means a
# downloaded model runs with no network at all; otherwise TRANSLATION_MODEL is
# treated as a Hugging Face repo id and fetched on first use.
# One-time setup (the repo is gated -- accept the terms on the model page
# first), from backend/:
#   venv/Scripts/hf.exe auth login
#   venv/Scripts/hf.exe download ai4bharat/indictrans2-en-indic-dist-200M \
#     --local-dir var/models/indictrans2-en-indic-dist-200M
# Downloads ~1.1 GB. Skip pytorch_model.bin (a duplicate of model.safetensors)
# but do NOT skip model.SRC / model.TGT -- they are the SentencePiece protos
# the tokenizer loads.
TRANSLATION_MODEL="ai4bharat/indictrans2-en-indic-dist-200M"
TRANSLATION_MODEL_DIR="var/models/indictrans2-en-indic-dist-200M"
# Used only when loading from the Hub rather than a local directory.
TRANSLATION_MODEL_CACHE_DIR="var/models/hf"

# "auto" uses CUDA when available and CPU otherwise. CPU is fully supported.
TRANSLATION_DEVICE="auto"
# 5 matches the model card. 1 (greedy) is about 2x faster with a small
# quality cost -- worth it if per-scan latency matters more than polish.
TRANSLATION_NUM_BEAMS=5
TRANSLATION_MAX_NEW_TOKENS=256
# Inferences run on one worker, so a burst of scans queues rather than
# starting several CPU-bound decodes at once.
TRANSLATION_MAX_CONCURRENCY=1
# Refuse to touch the network. Set true once the model is downloaded.
TRANSLATION_OFFLINE=false

# A local model is slower than an HTTP call: ~2s for a normal sentence on CPU,
# ~8s for a long label. 15s was tuned for a network round trip.
TRANSLATE_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Computer vision - hygiene indicator detection
# ---------------------------------------------------------------------------
#   "heuristic" -- deterministic OpenCV signals. No model file, no network,
#                  no download. Works on a fresh clone. This is the default.
#   "gemini" -- uses Gemini vision (needs GOOGLE_API_KEY)
#   "onnx_yolo" -- YOLO-family inference via onnxruntime. Requires
#                  CV_MODEL_PATH to point at an exported .onnx file; see
#                  scripts/export_yolov8_onnx.py.
CV_PROVIDER="heuristic"

# Path to the exported ONNX model. Relative paths resolve against backend/.
# The app NEVER downloads weights itself -- you export them once with
# scripts/export_yolov8_onnx.py and point at the result.
CV_MODEL_PATH="var/models/yolov8n.onnx"

# Detection thresholds (onnx_yolo only).
CV_CONFIDENCE_THRESHOLD=0.35
CV_NMS_IOU_THRESHOLD=0.45
CV_INPUT_SIZE=640
CV_TIMEOUT_SECONDS=20

# Heuristic detector thresholds (CV_PROVIDER=heuristic).
# Tune these against real stall photos; they are deliberately conservative
# so a clean stall does not produce findings.
CV_HEURISTIC_EDGE_DENSITY=0.16
CV_HEURISTIC_SMALL_BLOB_COUNT=45
CV_HEURISTIC_DARK_RATIO=0.30
CV_HEURISTIC_UNIFORM_REGION_RATIO=0.10

# Two views whose 64-bit perceptual hashes differ by <= this many bits are
# treated as the same photo. Guards against submitting one photo four times
# under four different view tags.
CV_DUPLICATE_HAMMING_THRESHOLD=5

# ---------------------------------------------------------------------------
# Hygiene checks
# ---------------------------------------------------------------------------
HYGIENE_UPLOAD_DIR="var/uploads/hygiene"
HYGIENE_MAX_UPLOAD_MB=8
HYGIENE_MAX_IMAGE_EDGE=1600

# Score weights. MUST sum to 1.0 -- validated at startup by
# services/hygiene/scoring.py, which fails loudly rather than producing a
# plausible-looking but wrong score.
# Visual evidence dominates because the checklist is self-reported and
# unverified: a vendor must not be able to lift a failing visual score just
# by ticking boxes.
HYGIENE_VISUAL_WEIGHT=0.70
HYGIENE_CHECKLIST_WEIGHT=0.30

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Used to build absolute URLs for stored scan images.
BACKEND_PUBLIC_URL="http://localhost:8000"

# Public origin of the FRONTEND. This is what a QR code encodes
# (`{PUBLIC_APP_URL}/stall/{CODE}`), so it must be an address a consumer can
# actually reach:
#   - NOT the API host (that is BACKEND_PUBLIC_URL)
#   - NOT localhost in production, or every printed sticker points at the
#     vendor's own phone
# Changing this after stickers are printed invalidates them.
PUBLIC_APP_URL="http://localhost:3000"
