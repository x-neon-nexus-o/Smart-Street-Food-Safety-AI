# Smart Street Food Safety AI - Frontend Environment
#
# Copy to `.env.local` in this directory (frontend/.env.local).
#
#   cp .env.local.example .env.local
#
# Variables must be prefixed NEXT_PUBLIC_ to be readable in the browser.

# Base URL of the FastAPI backend.
# Note: the API path prefix (/api/v1) is appended by src/lib/api.ts.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Google OAuth Client ID (for consumer login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# DigiLocker Client ID (for vendor login)
NEXT_PUBLIC_DIGILOCKER_CLIENT_ID=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OPTIONAL - only for testing the camera on a real phone
# ---------------------------------------------------------------------------
# Comma-separated hostnames allowed to load dev-server assets, e.g. when
# testing over your LAN.
#
# IMPORTANT: `navigator.mediaDevices` only exists in a SECURE CONTEXT
# (https:// or localhost). Opening http://192.168.x.x:3000 on a phone will
# show "Live camera is not available here" no matter what you put here -- the
# gallery fallback still works. To use the live camera on a phone, use an
# HTTPS tunnel (e.g. `npx localtunnel --port 3000` or ngrok) or a TLS cert.
#
# NEXT_ALLOWED_DEV_ORIGINS="192.168.1.5,my-laptop.local"
